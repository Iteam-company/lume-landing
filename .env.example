# ============================================================
# LUME — змінні оточення
# Скопіюйте цей файл у .env.local і заповніть значення:
#   cp .env.example .env.local
#
# Усі змінні з префіксом NEXT_PUBLIC_ потрапляють у браузер —
# не зберігайте тут паролі, токени чи ключі доступу.
# Значення вшиваються у збірку, тому після зміни потрібен
# новий `next build` (на Vercel — редеплой).
# ============================================================

# Бойова адреса сайту, без слеша в кінці. Приклад: https://lume.ua
# Від неї залежать canonical, sitemap.xml, robots.txt і OpenGraph,
# тому задайте її перед деплоєм.
NEXT_PUBLIC_SITE_URL=

# Контактний e-mail для структурованої розмітки (JSON-LD).
NEXT_PUBLIC_ORDER_EMAIL=

# Посилання для плаваючої кнопки WhatsApp.
# Приклад: https://wa.me/380671234567
NEXT_PUBLIC_WHATSAPP_LINK=

# Посилання для плаваючої кнопки Telegram. Необовʼязкове —
# без нього використовується https://t.me/lumestory.
NEXT_PUBLIC_TELEGRAM_LINK=

NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Signing secret Paddle notification destination (Sandbox).
# Paddle Dashboard → Developer tools → Notifications → [ваш destination] → секрет
# (pdl_ntfset_...). Це НЕ Paddle API key. Тільки серверний, без NEXT_PUBLIC_.
# Потрібен для app/api/paddle/webhook — без нього вебхук відповідає 400.
PADDLE_WEBHOOK_SECRET=

# n8n webhook для app/api/orders. Тільки серверні, без NEXT_PUBLIC_.
# Без них /api/orders відповідає 502.
N8N_LUME_WEBHOOK_URL=
N8N_LUME_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Location Observer — визначення країни відвідувача (діагностика).
# Обидві змінні потрібні ЛИШЕ для локальної перевірки та для
# debug-роуту. У звичайному проді їх не задають.
# ------------------------------------------------------------

# "1" вмикає dev-only підміну країни через заголовок x-vl-country.
# Працює тільки коли NODE_ENV !== "production"; у проді ігнорується завжди.
LOCATION_DEBUG=

# Секрет для GET /api/debug/location?token=...
# Без нього (або з невірним token) роут відповідає 404.
LOCATION_DEBUG_TOKEN=
